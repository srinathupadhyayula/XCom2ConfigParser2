<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>X2ModCompiler</RootNamespace>
    <AssemblyName>X2ModCompiler</AssemblyName>
    
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishDir>publish\</PublishDir>
    
    <!-- Build Configuration -->
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    
    <!-- Assembly Information -->
    <Version>1.0.0</Version>
    <Authors>XCom2Modding Community</Authors>
    <Description>XCOM 2 Mod Compiler - A C# based build system for XCOM 2 mods</Description>
    <Copyright>Copyright © 2025 XCom2Modding Community</Copyright>
  </PropertyGroup>
  
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>X2ModCompiler.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.5" />
    <PackageReference Include="ZLogger" Version="2.5.10" />
    <PackageReference Include="Kokuban" Version="0.2.0" />
    <PackageReference Include="Spectre.Console" Version="0.53.1" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.53.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\X2ModCompiler.Core\X2ModCompiler.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="docs\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="temp\**\*" />
    <None Include="temp\**\*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\EmptyUMap" />
  </ItemGroup>

</Project>
